# ============================================================
# AGY 2.0 Environment Configuration
# Copy this file to .env and configure your parameters
# ============================================================

# Master Unlock PIN (Default: 29105)
AGY_AUTH_PIN=29105

# Local Origin Port (Single port for both HTTP, REST, and WebSockets)
PORT=8090

# Optional: Cloudflare Zero-Trust Edge Gateway
# If using a custom domain (e.g. https://agypc.harjani.me or https://agy-a2.harjani.me),
# start.py will automatically synchronize its Cloudflare Quick Tunnel with this URL.
AGY_GATEWAY_URL=https://agypc.harjani.me
AGY_DOMAIN=agypc.harjani.me
CF_ZONE_NAME=harjani.me

# Optional: Session Secret for Edge Gateway HttpOnly cookies
AGY_SESSION_SECRET=sec_token_random_change_me_in_production
